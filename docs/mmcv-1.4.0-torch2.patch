+    def forward(self, *inputs, **kwargs):
+        """Run DDP forward with MMCV ``DataContainer`` support.
+
+        PyTorch 2.0 bypasses the overridable ``to_kwargs`` method and calls
+        its private tensor-only scatter helper directly. Explicitly scatter
+        here so that ``DataContainer`` inputs are unwrapped before delegating
+        to PyTorch DDP for normal synchronization and reducer handling.
+        """
+        if self.device_ids:
+            inputs, kwargs = self.scatter(inputs, kwargs, self.device_ids)
+            return super().forward(*inputs[0], **kwargs[0])
+        return super().forward(*inputs, **kwargs)
+
